# =============================================================================
# Health-Bot-AI — Environment Variables Preset
# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` to git (see .gitignore).
# =============================================================================

# ----- Primary provider: AITunnel (OpenAI-compatible) -----
# AITunnel — единый шлюз к разным LLM. Выберите ОДНУ модель, раскомментировав строку.
AITUNNEL_API_KEY=your_aitunnel_api_key_here
AITUNNEL_BASE_URL=https://api.aitunnel.ru/v1

# --- Варианты моделей на выбор (active — используется приложением) ---
# MiniMax (наша модель):
AITUNNEL_MODEL=MiniMax-M3
# AITUNNEL_MODEL=abab6.5s-chat      # альтернатива MiniMax
#
# Google Gemini (через AITunnel):
# AITUNNEL_MODEL=gemini-2.0-flash
# AITUNNEL_MODEL=gemini-1.5-pro      # более мощная, но медленнее
#
# OpenAI GPT (через AITunnel):
# AITUNNEL_MODEL=gpt-4o-mini         # быстрая и дешёвая
# AITUNNEL_MODEL=gpt-4o              # флагман, дороже
# AITUNNEL_MODEL=gpt-3.5-turbo       # legacy fallback

# ----- Fallback provider: YandexGPT (нативный API Яндекса, БЕЗ посредников) -----
# Использует собственный REST API Яндекс Облака, не AITunnel.
YANDEX_API_KEY=your_yandex_api_key_here
YANDEX_FOLDER_ID=your_yandex_folder_id_here
YANDEX_MODEL=yandexgpt-lite
# YANDEX_MODEL=yandexgpt             # полная версия, если lite мало

# ----- Generation parameters -----
TEMPERATURE=0.2
MAX_TOKENS=800
REQUEST_TIMEOUT=30
MAX_RETRIES=2

# ----- UI -----
APP_TITLE=Health-Bot-AI | OCX
APP_ICON=🏥