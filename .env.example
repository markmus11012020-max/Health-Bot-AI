# =============================================================================
# Health-Bot-AI — Environment Variables Preset
# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` to git (see .gitignore).
# =============================================================================

# ----- Runtime -----
ENVIRONMENT=development          # development | test | production
APP_VERSION=1.0.0
LOG_LEVEL=INFO

# ----- Primary provider: AITunnel (OpenAI-compatible) -----
AITUNNEL_API_KEY=your_aitunnel_api_key_here
AITUNNEL_BASE_URL=https://api.aitunnel.ru/v1

# --- Model options (uncomment exactly one) ---
# MiniMax (default):
AITUNNEL_MODEL=minimax-m3
# AITUNNEL_MODEL=abab6.5s-chat
# Google Gemini (via AITunnel):
# AITUNNEL_MODEL=gemini-2.0-flash
# AITUNNEL_MODEL=gemini-1.5-pro
# OpenAI GPT (via AITunnel):
# AITUNNEL_MODEL=gpt-4o-mini
# AITUNNEL_MODEL=gpt-4o

# ----- Fallback provider: YandexGPT (OpenAI-compatible endpoint) -----
# Use the OpenAI-compatible base URL. The native /foundationModels/v1/completion
# URL is normalised automatically for backward compatibility.
YANDEX_GPT_URL=https://llm.api.cloud.yandex.net/v1
YANDEX_API_KEY=your_yandex_api_key_here
YANDEX_IAM_TOKEN=                # IAM token has priority over API key
YANDEX_FOLDER_ID=your_yandex_folder_id_here
YANDEX_GPT_MODEL=yandexgpt-lite  # yandexgpt-lite | yandexgpt
YANDEX_TIMEOUT_S=120

# ----- Generation parameters -----
TEMPERATURE=0.2
MAX_TOKENS=800
REQUEST_TIMEOUT=30
MAX_RETRIES=2
ENABLE_FALLBACK=true

# ----- Knowledge base / RAG -----
KB_PATH=knowledge_base.txt
KB_TOP_K=3
KB_MAX_CHARS=6000

# ----- Cache -----
CACHE_MAXSIZE=256
CACHE_TTL_SECONDS=86400
# Leave empty for in-process cache (single worker). Set for multi-worker:
# REDIS_URL=redis://localhost:6379/0
REDIS_URL=

# ----- Persistence -----
# SQLite is fine for the demo. Production: PostgreSQL + psycopg.
DATABASE_URL=sqlite:///data/health_bot.db
# DATABASE_URL=postgresql+psycopg://healthbot:healthbot@localhost:5432/healthbot

# ----- API security -----
# API_KEY is required in production. Empty = auth disabled in development.
API_KEY=
# ADMIN_API_KEY is required in production for cache/admin operations.
ADMIN_API_KEY=
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
IDEMPOTENCY_TTL_SECONDS=3600

# ----- Guardrails -----
GUARDRAILS_ENABLED=true

# ----- UI -----
APP_TITLE=Health-Bot-AI | OCX
APP_ICON=🏥

# ----- A/B prompt variant -----
# standard — базовый дружелюбный (по умолчанию)
# expert   — клинический, аргументированный
# warm     — тёплый, эмпатичный (миссия OCX)
PROMPT_VARIANT=standard
